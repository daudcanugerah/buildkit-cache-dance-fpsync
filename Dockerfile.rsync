# Minimal rsync/fpsync image for buildkit-cache-dance
# Used when rsync-mode is enabled for differential cache sync.
# Debian (not Alpine) because fpart/fpsync is packaged in Debian but not Alpine.
# fpsync = fpart-driven parallel rsync, much faster on large caches.
FROM debian:bookworm-slim

RUN apt-get update -qq \
  && apt-get install -y -qq --no-install-recommends rsync fpart bash \
  && rm -rf /var/lib/apt/lists/*

# fpsync is a /bin/sh script that calls 'set -m' for job-control isolation;
# under dash (Debian default) that warns "can't access tty; job control
# turned off" on every run and silently disables the isolation. Point /bin/sh
# at bash so fpsync behaves as intended and runs quietly.
RUN ln -sf bash /bin/sh

ENTRYPOINT ["/bin/sh"]
